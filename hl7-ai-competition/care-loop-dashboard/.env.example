# care-loop-fhir-server (internal HAPI store) — Patient, Observation (vitals), RiskAssessment
CARE_LOOP_FHIR_SERVER_URL=http://localhost:9091/fhir

# care-loop-ai-service — POST /questionnaires
CARE_LOOP_AI_SERVICE_URL=http://localhost:8003

# ehr-fhir-server — Task (front-desk triage handoff), used by the pipeline view
EHR_FHIR_SERVER_URL=http://localhost:9090/fhir/r4

# whatsapp-simulator — GET /api/sessions, used by the pipeline view
WHATSAPP_SIMULATOR_URL=http://localhost:3000

# path to the local request-log SQLite file (bun:sqlite). Relative paths resolve
# against the process cwd.
REQUEST_LOG_DB_PATH=./data/request-log.sqlite
