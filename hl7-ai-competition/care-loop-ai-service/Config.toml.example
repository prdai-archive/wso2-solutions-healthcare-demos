fhirMcpUrl = "http://fhir-mcp-server:8000/mcp/"
knowledgeMcpUrl = "http://care-loop-knowledge-service:8000/mcp"
pubmedMcpUrl = "http://pubmed-mcp-server:3010/mcp"
listenPort = 8003

# Choose "openai" or "anthropic". Both route only through the AMP AI gateway; there is no direct-to-provider mode.
modelProvider = "openai"

# openAiApiKey is the minted careloop-openai gateway key (contents of amp-shared/openai-gateway.key); openAiServiceUrl is the AMP invoke URL, never api.openai.com. nanoModel/fullModel select the underlying OpenAI model.
openAiApiKey = "your-careloop-openai-gateway-key"
openAiServiceUrl = "http://amp:22893/careloop-openai"
nanoModel = "gpt-4.1-nano"
fullModel = "gpt-4.1"

# anthropicApiKey is the minted careloop-anthropic gateway key (contents of amp-shared/anthropic-gateway.key); anthropicServiceUrl is the AMP invoke URL with the "/v1" suffix (the stock provider appends "/messages"), never api.anthropic.com.
anthropicApiKey = "your-careloop-anthropic-gateway-key"
anthropicServiceUrl = "http://amp:22893/careloop-anthropic/v1"

dashboardEventsUrl = "http://care-loop-dashboard:3003"
