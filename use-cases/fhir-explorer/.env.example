# Revoke any key pasted into chat or committed elsewhere before using it here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# WSO2 FHIR MCP subprocess settings.
FHIR_MCP_REQUEST_TIMEOUT=30
FHIR_MCP_IDLE_TTL_MS=300000

# AI gateway control-plane token (required by setup.sh; seeded into a Secret, not
# committed). Copy it from your OpenChoreo control-plane install.
CONTROLPLANE_TOKEN=
# Optional gateway/APIM credential overrides (setup.sh uses dev defaults otherwise).
GATEWAY_ADMIN_PASSWORD=
APIM_OAUTH2_CLIENT_ID=
APIM_OAUTH2_CLIENT_SECRET=
APIM_OAUTH2_PASSWORD=
