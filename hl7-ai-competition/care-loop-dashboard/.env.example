# care-loop-fhir-server (internal HAPI store) — Patient, used for the roster
# (names/DOB).
CARE_LOOP_FHIR_SERVER_URL=http://localhost:9091/fhir

# care-loop-ai-service — POST /questionnaires
CARE_LOOP_AI_SERVICE_URL=http://localhost:8003

# path to the local SQLite file (bun:sqlite) holding both the request_log and
# events tables. Relative paths resolve against the process cwd.
REQUEST_LOG_DB_PATH=./data/request-log.sqlite

# Other services report progress by POSTing events at this dashboard directly —
# no env var needed here, this dashboard is the receiver:
#   POST /api/events
#   Body: { "patientId": string, "label": string, "detail"?: string }
#   No auth (internal network), fire-and-forget — responds 202 immediately.
