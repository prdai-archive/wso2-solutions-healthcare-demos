# Copy to .env and fill in. Only OPENAI_API_KEY is required.

# OpenAI API key used as the AMP gateway's upstream credential for OpenAI.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional. The AMP OTLP trace-ingest endpoint (the compose default works).
# AMP_OTEL_ENDPOINT=http://amp:22893/otel

# Optional. Trace-ingest auth is disabled on the local demo gateway, so this
# is unused unless you re-enable the otel route's jwt-auth policy.
# AMP_AGENT_API_KEY=

# Optional. OpenChoreo identity UUIDs that scope agent traces to the registered
# agent in the AMP console. These are AMP-instance specific; amp-init resolves
# and writes them at boot, so leave them unset unless overriding manually.
# OC_PROJECT_UID=
# OC_COMPONENT_UID=
# OC_ENVIRONMENT_UID=
# OC_NAMESPACE=default
