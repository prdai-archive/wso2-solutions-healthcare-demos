OPENAI_API_KEY=
# Optional OpenAI-compatible gateway endpoint.
# OPENAI_BASE_URL=
# Optional model name. Defaults to gpt-5-nano.
# OPENAI_MODEL=
# Optional reasoning effort for reasoning-capable models:
# none, minimal, low, medium, high, or xhigh. Defaults to medium.
# OPENAI_REASONING_EFFORT=
# Comma-separated browser origins allowed to call /api/*.
# Defaults to the Explorer's own origin when unset.
# EXPLORER_ALLOWED_ORIGINS=https://explorer.example.com
