# care-loop-fhir-server — Patient, Observation, QuestionnaireResponse, RiskAssessment.
CARE_LOOP_FHIR_SERVER_URL=http://localhost:9091/fhir

# care-loop-ai-service — POST /questionnaires
CARE_LOOP_AI_SERVICE_URL=http://localhost:8003

# ehr-fhir-server — Task (alerts), Condition/MedicationRequest/AllergyIntolerance (patient history).
EHR_FHIR_SERVER_URL=http://localhost:9090/fhir/r4

# path to the local SQLite file (bun:sqlite) holding the request_log and events tables; relative paths resolve against the process cwd.
REQUEST_LOG_DB_PATH=./data/request-log.sqlite

# no env var needed here — other services POST events straight at this dashboard (POST /api/events); see README.md for the contract.
